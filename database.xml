<?xml version="1.0" encoding="UTF-8"?>
<database>
    <projects>
        <table name="tags" no-auto-update="1" no-site-reference="1">
            <field type="string" length="255" primary="true">tag</field>
            <field type="string" length="255">title</field>
            <field type="text" nullable="true">desc</field>
            <field type="text" nullable="true">image</field>
            <field type="string" length="20" nullable="true" default="null">url</field>
            <field type="boolean" default="0">generated</field>
            <field type="string" length="255" nullable="true" default="null">generator</field>
            <index>title</index>
        </table>

        <table name="tags_groups" no-auto-update="1" no-site-reference="1">
            <field type="bigint" autoincrement="true" primary="true">id</field>
            <field type="string" length="255" default="">title</field>
            <field type="string" length="255" default="">workingtitle</field>
            <field type="text" nullable="true">desc</field>
            <field type="text" nullable="true">image</field>
            <field type="text" nullable="true">tags</field>
            <field type="integer" default="1">priority</field>
            <field type="boolean" default="0">generated</field>
            <field type="string" length="255" nullable="true" default="null">generator</field>
            <field type="bigint" nullable="true">parentId</field>
            <index>title</index>
            <index>parentId</index>
        </table>

        <table name="tags_groups_cache" no-auto-update="1" no-site-reference="1">
            <field type="bigint" primary="true">id</field>
            <field type="text">tags</field>
            <field type="integer">count</field>
        </table>

        <table name="tags_cache" no-auto-update="1" no-site-reference="1">
            <field type="string" length="255" primary="true">tag</field>
            <field type="text" nullable="true">sites</field>
            <field type="integer">count</field>
        </table>

        <table name="tags_siteCache" no-auto-update="1" no-site-reference="1">
            <field type="bigint" primary="true">id</field>
            <field type="string" length="255" nullable="true" default="null">name</field>
            <field type="string" length="255">title</field>
            <field type="text" nullable="true">tags</field>
            <field type="datetime" nullable="true" default="null">c_date</field>
            <field type="datetime" default="CURRENT_TIMESTAMP">e_date</field>
        </table>

        <table name="tags_sites" no-auto-update="1" no-site-reference="1">
            <field type="bigint" primary="true">id</field>
            <field type="text" nullable="true">tags</field>
        </table>
    </projects>
</database>
